# 默认：文本文件使用 LF 换行符（跨平台一致性）
* text=auto eol=lf

# Windows 专用脚本必须使用 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件：禁止 Git 自动转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.pdf binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.wasm binary
*.key binary
*.keystore binary

# 大文件标记（GitHub LFS 候选，未启用 LFS 时仅声明属性）
*.zip binary
*.7z binary
*.msi binary
